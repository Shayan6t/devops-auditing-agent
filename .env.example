# =====================================================================
# DevOps Auditing Agent Configuration
# =====================================================================
# Copy this file to '.env' and populate your API credentials:
# cp .env.example .env
#
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL!
# =====================================================================

# LLM Provider selection: "gemini" (default, free), "groq" (fast, free), or "openai"
LLM_PROVIDER=gemini

# Primary recommended model: Google Gemini (Free API key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Alternative: Groq (Free fast inference at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative: OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Agent loop control settings
MAX_AUDIT_STEPS=15
AGENT_TEMPERATURE=0.1
AGENT_TIMEOUT_SECONDS=180
